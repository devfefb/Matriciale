rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras para emulador e desenvolvimento
    match /{document=**} {
      allow read, write: if true; // Permissivo para desenvolvimento
    }
    
    // Regras de produção (comentadas para desenvolvimento)
    /*
    match /municipio/{municipioId} {
      allow read, write: if request.auth != null;
      
      match /unidades/{unidadeId} {
        allow read, write: if request.auth != null;
        
        match /medicamentos_unidade/{medicamentoId} {
          allow read, write: if request.auth != null;
        }
      }
    }
    */
  }
}
