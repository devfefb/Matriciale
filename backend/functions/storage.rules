rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Regras para emulador e desenvolvimento
    match /{allPaths=**} {
      allow read, write: if true; // Permissivo para desenvolvimento
    }
    
    // Regras de produção (comentadas para desenvolvimento)
    /*
    match /uploads/{municipio}/{unidade}/{tipo}/{arquivo} {
      allow write: if request.auth != null && 
                   resource == null && 
                   request.resource.size < 50 * 1024 * 1024; // 50MB max
      allow read: if request.auth != null;
    }
    */
  }
}
