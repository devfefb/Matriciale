# Configurações do Firebase
# Copie este arquivo para .env e preencha com suas credenciais

# === CONFIGURAÇÕES BÁSICAS ===
NODE_ENV=development
PORT=3001
DISABLE_AUTH=true

# === FIREBASE STORAGE (OPCIONAL EM DESENVOLVIMENTO) ===
# Em desenvolvimento, deixe vazio para usar armazenamento local
# Em produção, configure com o bucket do seu projeto
STORAGE_BUCKET_URL=

# Exemplo para produção:
# STORAGE_BUCKET_URL=seu-projeto.appspot.com

FIREBASE_PROJECT_ID=seu-projeto-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FIREBASE_TYPE=service_account
FIREBASE_PRIVATE_KEY_ID=chave-privada-id
FIREBASE_CLIENT_ID=client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40seu-projeto.iam.gserviceaccount.com
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# === DESENVOLVIMENTO LOCAL ===
# Para desenvolvimento, você só precisa:
# 1. Configurar as credenciais do Firebase acima
# 2. Deixar STORAGE_BUCKET_URL vazio (os arquivos serão salvos localmente)
# 3. NODE_ENV=development (já configurado)

# === PRODUÇÃO ===
# Para produção, configure:
# 1. NODE_ENV=production
# 2. STORAGE_BUCKET_URL=seu-projeto.appspot.com

# Como obter as credenciais:
# 1. Acesse o Console do Firebase (https://console.firebase.google.com)
# 2. Selecione seu projeto
# 3. Vá em Configurações do Projeto > Contas de serviço
# 4. Clique em "Gerar nova chave privada"
# 5. Baixe o arquivo JSON e copie os valores para este arquivo .env
