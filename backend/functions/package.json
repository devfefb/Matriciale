{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && node dist/local-dev.js",
    "start": "npm run serve",
    "deploy": "firebase deploy --only functions",
    
    "emulator": "powershell -ExecutionPolicy Bypass -File ./scripts/start-emulator.ps1",
    "emulator:start": "npm run emulator",
    "emulator:test": "powershell -ExecutionPolicy Bypass -File ./scripts/test-emulator.ps1",
    "emulator:ui": "start http://localhost:4000",
    
    "inserir-dados": "ts-node src/scripts/executar-insercao.ts",
    "validar-dados": "ts-node src/scripts/executar-validacao.ts",
    "calcular-campos": "ts-node src/scripts/calculos/executar-calculos.ts",
    "inserir-semana": "ts-node src/scripts/auxiliar/executar-inserir-semana.ts",
    "preencher-nulos": "ts-node src/scripts/auxiliar/executar-preencher-nulos.ts",
    "extrair-campos-calculados": "ts-node src/scripts/auxiliar/executar-extrair-campos-calculados.ts",
    "calcular-estoques": "ts-node src/scripts/executar-processamento-estoque.ts",
    "validar-calculos": "ts-node src/scripts/testes/executar-validacao-completa.ts",

    "script-deletar-medicamentos": "ts-node src/scripts/testes/script.ts"
  },
  "engines": {
    "node": "20"
  },
  "main": "dist/index.js",
  "dependencies": {
    "@google-cloud/storage": "^7.16.0",
    "axios": "^1.10.0",
    "bcrypt": "^5.1.1",
    "chokidar": "^4.0.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2",
    "mime-types": "^3.0.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mime-types": "^2.1.4",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^24.3.0",
    "@types/node-cache": "^4.2.5",
    "@types/node-fetch": "^2.6.11",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "private": true
}
